# Neon : chaîne de connexion POOLÉE (hôte contenant "-pooler") pour l'app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon : chaîne de connexion DIRECTE (sans "-pooler") pour les migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# URL publique de l'app (en local : http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
